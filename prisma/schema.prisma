generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//rings, pendant, bracelet, earrings, watches
model Jewelry {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  material  String
  gemstone  String?
  cost      Float
  retail    Float  
  quantity  Int      @default(1) 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

